{
  "name": "cansat-gui",
  "version": "1.0.0",
  "description": "CanSat Competition GUI Application",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently \"bun run dev:vite\" \"bun run dev:electron\"",
    "dev:vite": "cross-env NODE_ENV=development vite",
    "dev:electron": "cross-env NODE_ENV=development wait-on http://localhost:5173 && bun run compile:electron && electron dist-electron/main.js",
    "compile:electron": "tsc -p tsconfig.electron.json",
    "build": "vite build && bun run compile:electron",
    "build:electron": "bun run build && electron-builder",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.cansat.gui",
    "productName": "CanSat GUI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "devDependencies": {
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.3.0",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^10.0.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@types/react-router-dom": "^5.3.3",
    "@types/serialport": "^10.2.0",
    "date-fns": "^4.1.0",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.2",
    "immer": "^10.1.3",
    "lodash": "^4.17.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.1.2",
    "serialport": "^13.0.0",
    "xbee-api": "^0.6.0",
    "zod": "^4.1.9",
    "zustand": "^5.0.8"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
